/system       /dev/block/mapper/system      ext4  flags=display="System";slotselect;first_stage_mount
/system_ext   /dev/block/mapper/system_ext  ext4  flags=display="System_ext";slotselect;first_stage_mount
/product      /dev/block/mapper/product     ext4  flags=display="Product";slotselect;first_stage_mount
/vendor       /dev/block/mapper/vendor      ext4  flags=display="Vendor";slotselect;first_stage_mount
/odm          /dev/block/mapper/odm         ext4  flags=display="Odm";slotselect;first_stage_mount
/metadata     /dev/block/by-name/metadata   ext4  flags=display="Metadata";wipeingui;mounttodecrypt
/data         /dev/block/by-name/userdata   f2fs  flags=display="Data";wipeingui;mounttodecrypt;encryptable=ice
/usb-otg      auto                          auto  flags=display="USB-OTG";removable;storage
